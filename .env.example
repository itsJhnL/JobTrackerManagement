# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL used in auth email redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI provider (server-side only; never prefixed with NEXT_PUBLIC_)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Scheduled jobs (Vercel cron hits /api/cron/exchange-rates with this bearer token)
CRON_SECRET=
# Service role key (server only) lets the cron write shared exchange rates without a user session
SUPABASE_SERVICE_ROLE_KEY=

# Google integrations (Gmail read-only + Calendar events). Create an OAuth client (Web application)
# in Google Cloud with redirect URI {NEXT_PUBLIC_SITE_URL}/api/integrations/google/callback and
# enable the Gmail API and Google Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=
